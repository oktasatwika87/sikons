# Salin file ini jadi .env lalu sesuaikan.
#   cp .env.example .env
#
# .env TIDAK ikut di-commit (lihat .gitignore). Yang di-commit hanya contoh
# ini, supaya orang lain (dan kamu 3 bulan lagi) tahu env apa saja yang perlu
# diisi tanpa pernah melihat nilai aslinya.

APP_ENV=development
HTTP_PORT=8080
LOG_LEVEL=debug

# Kunci penandatangan JWT. Minimal 32 karakter — HS256 mengambil kekuatannya
# dari panjang kunci, dan secret pendek bisa ditebak offline dalam hitungan
# detik oleh siapa pun yang punya satu token saja.
# Buat yang baru dengan: openssl rand -base64 48
JWT_SECRET=ganti-dengan-nilai-acak-minimal-32-karakter-jangan-pakai-yang-ini
ACCESS_TOKEN_TTL=15m

# Port 5433 mengikuti docker-compose.yml.
# sslmode=disable hanya untuk lokal; di VPS nanti wajib require.
DATABASE_URL=postgres://sikons:sikons_dev@localhost:5433/sikons?sslmode=disable

REDIS_URL=redis://localhost:6380/0

# Database TERPISAH khusus test. Test melakukan TRUNCATE di awal tiap test,
# jadi jangan pernah mengarahkan ini ke database development.
# Siapkan sekali dengan: make test-db
TEST_DATABASE_URL=postgres://sikons:sikons_dev@localhost:5433/sikons_test?sslmode=disable
